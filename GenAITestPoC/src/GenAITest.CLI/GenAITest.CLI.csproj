<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>genaitest</ToolCommandName>
    <PackageId>GenAITest.Tool</PackageId>
    <Version>1.0.0</Version>
    <Authors>Shanaka</Authors>
    <Description>GenAI Test Framework CLI — generate xUnit integration tests from BA documents using LLM or RAG.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GenAITest.Engine\GenAITest.Engine.csproj" />
  </ItemGroup>

</Project>
