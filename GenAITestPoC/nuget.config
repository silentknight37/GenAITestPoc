<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Local folder feed — run the pack-and-publish script to add new versions.
      External projects install with: dotnet add package GenAITest.Engine
    -->
    <add key="GenAITest-Local" value="./nuget-local" />
    <add key="nuget.org"       value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
